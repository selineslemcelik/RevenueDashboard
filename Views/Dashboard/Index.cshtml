<body>
    <div class="topbar">
        <div class="brand"><span class="logo">R</span><span><div class="bt">Revenue Dashboard</div><div class="bs">Executive Revenue Monitoring</div></span></div>
        <div class="deck-ctrl">
            <button class="ctrl-btn" id="prevBtn" title="Önceki">‹</button>
            <div class="screen-title" id="screenTitle">Kısa Vade</div>
            <button class="ctrl-btn" id="nextBtn" title="Sonraki">›</button>
            <svg class="ring" viewBox="0 0 36 36"><circle class="bg" cx="18" cy="18" r="15"/><circle class="fg" id="ringFg" cx="18" cy="18" r="15"/></svg>
            <button class="ctrl-btn" id="playBtn" title="Durdur / Oynat">⏸</button>
        </div>
        <div class="topright">
            <div class="clock"><div class="dt"><span class="dot"></span> <span id="clockDate">—</span></div><b id="clockTime">—</b></div>
            <a class="icon-btn" href="/Dashboard" title="Yenile">⟳</a>
            <button class="icon-btn" id="fsBtn" title="Tam ekran">⛶</button>
            <div class="divider"></div>
            <div class="user-chip"><span class="av">@(userName.Length>0?userName.Substring(0,1).ToUpper():"U")</span><span><span class="nm">@userName</span><br><span class="rl">@roleLabel</span></span></div>
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;"><button class="icon-btn" type="submit" title="Çıkış">⎋</button></form>
        </div>
    </div>

    <div class="wrap">
        <!-- EKRAN 1 — Operational Dashboard -->
        <div class="screen active" id="screen1">
            <div class="kpi-grid">
                <div class="card2 kpi @alarm(dayChange)"><div class="top"><span class="label">Son Veri Gününün Geliri</span><span class="ic">@Html.Raw(kpiIconSvg("wallet"))</span></div><div class="body"><div class="value-wrap"><div class="value">$@((today / USD_TRY_RATE).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</div><div class="kpi-date-highlight">@lastDayLabel</div></div><div class="changeBox"><div class="pct chg @cls(dayChange)">@arrow(dayChange) %@Math.Abs(dayChange).ToString("N0")</div><div class="txt">önceki güne göre</div></div></div></div>
                <div class="card2 kpi @alarm(monthChange)"><div class="top"><span class="label">Bu Ay Geliri</span><span class="ic">@Html.Raw(kpiIconSvg("trending-up"))</span></div><div class="body"><div class="value">$@((thisMonth / USD_TRY_RATE).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</div><div class="changeBox"><div class="pct chg @cls(monthChange)">@arrow(monthChange) %@Math.Abs(monthChange).ToString("N0")</div><div class="txt">geçen aya göre</div></div></div></div>
                <div class="card2 kpi"><div class="top"><span class="label">Günlük Ortalama</span><span class="ic">@Html.Raw(kpiIconSvg("bar-chart-3"))</span></div><div class="value">$@((dailyAvg / USD_TRY_RATE).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</div><div class="desc">Son 30 günün ortalaması</div></div>
                <div class="card2 kpi @alarm(yearChange)"><div class="top"><span class="label">Yıllık Gelir</span><span class="ic">@Html.Raw(kpiIconSvg("building-2"))</span></div><div class="body"><div class="value">$@((thisYear / USD_TRY_RATE).ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</div><div class="changeBox"><div class="pct chg @cls(yearChange)">@arrow(yearChange) %@Math.Abs(yearChange).ToString("N0")</div><div class="txt">geçen yıla göre</div></div></div></div>
            </div>
            <div class="grid row-main">
                <div class="card2 flexcard" style="height:340px;"><h5>Son 30 Gün Gelir Trendi</h5><div class="q">Günlük gelir + 7 günlük hareketli ortalama</div><div class="panel-body"><canvas id="dailyChart"></canvas></div></div>
                <div class="card2 flexcard" style="height:340px;">
                    <h5>Aylık Şirket Liderlik Tablosu</h5>
                    <div class="q">Bu ayın toplam gelirine göre sıralı</div>
                    <div class="panel-body">
                        <div class="lead-list">
                            @{ int leadRank = 1; }
                            @foreach (var cm in Model.CompanyMonthly)
                            {
                                <div class="lead-row">
                                    <span class="lead-rank">@leadRank</span>
                                    <span class="lead-name">@cm.Company</span>
                                    <span class="lead-val">@compactMoney(cm.ThisMonthRevenue)</span>
                                    <span class="lead-chg @(cm.ChangePercent>=0?"up":"down")">@(cm.ChangePercent>=0?"↑":"↓") %@Math.Abs(cm.ChangePercent).ToString("N0")</span>
                                    <svg class="lead-spark" viewBox="0 0 60 22" preserveAspectRatio="none" data-points="@string.Join(",", cm.Sparkline6Month.Select(v => v.ToString(System.Globalization.CultureInfo.InvariantCulture)))"></svg>
                                </div>
                                leadRank++;
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="grid row-main executive-bottom">
                <div class="card2 flexcard" style="height:260px;">
                    <h5>En Çok Gelir Getiren Kanallar</h5>
                    <div class="q">Bu ayın lider kanalları · geçen aya göre performans</div>
                    <div class="channel-performance">
                        @{ int channelRank = 1; }
                        @foreach (var channel in Model.TopChannelsMonthly)
                        {
                            var positive = channel.ChangePercent >= 0;
                            <div class="channel-performance-row">
                                <div class="channel-rank">@channelRank</div>
                                <div class="channel-info">
                                    <div class="channel-name">@channel.ChannelName</div>
                                    <div class="channel-company">@channel.Company</div>
                                </div>
                                <div class="channel-figures">
                                    <div class="channel-revenue">@compactMoney(channel.ThisMonthRevenue)</div>
                                    <div class="channel-change @(positive ? "positive" : "negative")">
                                        @(positive ? "▲" : "▼") %@Math.Abs(channel.ChangePercent).ToString("N1")
                                    </div>
                                </div>
                            </div>
                            channelRank++;
                        }
                    </div>
                </div>

                <div class="card2 flexcard" style="height:260px;">
                    <h5>En Çok Gelir Getiren 5 Ülke Trendi</h5>
                    <div class="q">Son 1 ay · ülke bazlı gelir hareketi</div>
                    <div class="panel-body"><canvas id="continentTrendChart"></canvas></div>
                </div>

                <div class="card2 flexcard" style="height:260px;">
                    <h5>Platform Performansı</h5>
                    <div class="q">Bu ay vs geçen ay · büyüme ve platformun lider kanalı</div>
                    <div class="platform-executive-grid">
                        @foreach (var platform in Model.PlatformMonthly.Where(x => x.Platform == "YouTube" || x.Platform == "Facebook"))
                        {
                            var positive = platform.ChangePercent >= 0;
                            <div class="platform-executive-card">
                                <div class="platform-exec-header">
                                    <div class="platform-exec-title">
                                        <span class="platform-exec-icon" style="background:@platColor(platform.Platform)">@platIcon(platform.Platform)</span>
                                        @platform.Platform
                                    </div>
                                    <div class="platform-exec-change @(positive ? "positive" : "negative")">
                                        @(positive ? "▲" : "▼") %@Math.Abs(platform.ChangePercent).ToString("N1")
                                    </div>
                                </div>
                                <div class="platform-exec-revenue">@compactMoney(platform.ThisMonthRevenue)</div>
                                <div class="platform-exec-caption">Bu ay toplam gelir · geçen ay @compactMoney(platform.LastMonthRevenue)</div>
                                <div class="platform-divider"></div>
                                <div class="platform-leader-label">AYIN LİDER KANALI</div>
                                <div class="platform-leader">@platform.TopChannel</div>
                                <div class="platform-leader-revenue">@compactMoney(platform.TopChannelRevenue)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- EKRAN 2 — Executive Analytics -->
        <div class="screen" id="screen2">
            <div class="grid row-main">
                <div class="card2 flexcard" style="height:340px;"><h5>Son 12 Ay Gelir Trendi</h5><div class="q">Uzun vadeli büyüme eğilimi (son ay devam ediyor)</div><div class="panel-body"><canvas id="monthlyChart"></canvas></div></div>
                <div class="card2 flexcard" style="height:340px;">
                    <h5>Dünya Haritası</h5>
                    <div class="q">Kıta bazlı gelir dağılımı</div>
                    <div class="geo-body">
                        <div class="geo-left">
                            @{ int contIdx = 0; }
                            @foreach (var ct in Model.ContinentRevenue.OrderByDescending(x => x.Revenue))
                            {
                                <div class="geo-row @(contIdx==0?"lead":"")">
                                    <span class="geo-dot" style="background:@merzigoColor(contIdx)"></span>
                                    <div class="geo-info">
                                        <div class="geo-top"><span class="geo-name">@ct.Continent</span><span class="geo-pct">%@ct.Percentage.ToString("N1")</span></div>
                                        <div class="geo-bar"><span style="width:@(ct.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                        <div class="geo-val">@compactMoney(ct.Revenue)</div>
                                    </div>
                                </div>
                                contIdx++;
                            }
                        </div>
                        <div class="geo-right" id="globeViz"></div>
                    </div>
                </div>
            </div>
            <div class="grid row-main portfolio-platform-row">
                <div class="card2 flexcard" style="height:340px;">
                    <h5>Şirket Portföy Performansı</h5>
                    <div class="q">Portföy gücü ve en başarılı içerik</div>
                    <div class="panel-body" style="overflow:hidden;">
                        <div class="cpp-list">
                            <div class="cpp-head">
                                <span>Şirket</span>
                                <span>Kanal Sayısı</span>
                                <span class="num">Toplam Gelir</span>
                                <span>En Başarılı İçerik</span>
                                <span class="num">İçerik Geliri</span>
                            </div>
                            @foreach (var cp in Model.CompanyPortfolio.OrderByDescending(x => x.TotalRevenue))
                            {
                                <div class="cpp-row">
                                    <span class="cpp-company">@cp.Company</span>
                                    <span class="cpp-channels">@cp.ChannelCount</span>
                                    <span class="cpp-num">@compactMoney(cp.TotalRevenue)</span>
                                    <span class="cpp-content">@cp.TopContent</span>
                                    <span class="cpp-num">@compactMoney(cp.TopContentRevenue)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card2 flexcard" style="height:340px;">
                    <h5>Platform Gelir & Pay Dağılımı</h5>
                    <div class="q">Mecra bazlı gelir kırılımı</div>
                    <div class="ph2-body">
                        <div class="ph2-trend">
                            <div class="ph2-trend-legend">
                                <span><i style="background:@merzigoColor(0)"></i>YouTube</span>
                                <span><i style="background:#7FD7BF"></i>Facebook</span>
                            </div>
                            <div class="panel-body"><canvas id="platformTrendChart"></canvas></div>
                        </div>
                        <div class="ph2-donut"><canvas id="platformSliceDonut"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dots"><span class="on" data-i="0"></span><span data-i="1"></span></div>
    </div>

    <div class="ticker"><div class="ticker-track" id="tickerTrack"></div></div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/globe.gl"></script>
    <script>
        const d = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            dLabels = Model.DailyRevenue.Select(x => x.Label), dValues = Model.DailyRevenue.Select(x => x.Value),
            mLabels = Model.MonthlyRevenue.Select(x => x.Label), mValues = Model.MonthlyRevenue.Select(x => x.Value),
            chLabels = Model.TopChannels.Select(x => x.Label), chValues = Model.TopChannels.Select(x => x.Value),
            moverNames = Model.TopMovers.Select(x => x.Name), moverPct = Model.TopMovers.Select(x => x.GrowthPercent),
            ctLabels = Model.ContinentTrend.FirstOrDefault() != null ? Model.ContinentTrend.First().Points.Select(p => p.Label) : new List<string>(),
            ctSeries = Model.ContinentTrend.OrderByDescending(x => x.Points.Sum(p => p.Value)).Select(x => new { x.Continent, Values = x.Points.Select(p => p.Value) }),
            psLabels = Model.PlatformRevenue.Where(x => x.Platform == "YouTube" || x.Platform == "Facebook").OrderByDescending(x => x.Revenue).Select(x => x.Platform),
            psValues = Model.PlatformRevenue.Where(x => x.Platform == "YouTube" || x.Platform == "Facebook").OrderByDescending(x => x.Revenue).Select(x => x.Revenue),
            psColors = new[]{"#00a97c","#7FD7BF"},
            psPct = Model.PlatformRevenue.Where(x => x.Platform == "YouTube" || x.Platform == "Facebook").OrderByDescending(x => x.Revenue).Select(x => "%" + x.Percentage.ToString("N1")),
            psVal = Model.PlatformRevenue.Where(x => x.Platform == "YouTube" || x.Platform == "Facebook").OrderByDescending(x => x.Revenue).Select(x => compactMoney(x.Revenue)),
            ptYoutube = Model.PlatformMonthly.FirstOrDefault(x => x.Platform == "YouTube") != null ? Model.PlatformMonthly.First(x => x.Platform == "YouTube").Sparkline12Month : new List<decimal>(),
            ptFacebook = Model.PlatformMonthly.FirstOrDefault(x => x.Platform == "Facebook") != null ? Model.PlatformMonthly.First(x => x.Platform == "Facebook").Sparkline12Month : new List<decimal>(),
            ptLabels = Model.MonthlyRevenue.Count > 1 ? Model.MonthlyRevenue.SkipLast(1).TakeLast(12).Select(x => x.Label) : Model.MonthlyRevenue.Select(x => x.Label)
        }));

        const GREEN='#00a97c', MINT='#ade4d0', GRID='#e6f1ec';
        const soft=(hex,a)=>{const n=parseInt(hex.slice(1),16);return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`;};
        Chart.defaults.font.family='system-ui,sans-serif'; Chart.defaults.color='#6b8079';
        Chart.defaults.plugins.tooltip.padding=10; Chart.defaults.plugins.tooltip.backgroundColor='#1f2d29';
        Chart.defaults.plugins.tooltip.cornerRadius=8;
        Chart.defaults.animation={duration:900,easing:'easeOutQuart'};

        const tl=new Intl.NumberFormat('en-US');
        const USD_TRY_RATE = 47.35; // 27 Temmuz 2026 piyasa kuru
        const money=v=>'$'+new Intl.NumberFormat('en-US',{notation:'compact',maximumFractionDigits:1}).format(v/USD_TRY_RATE);
        const full=v=>'$'+tl.format(Math.round(v/USD_TRY_RATE));
        const yA=()=>({y:{ticks:{callback:money},grid:{color:GRID},border:{display:false}},x:{grid:{display:false}}});
        const AY=['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];
        const shortDay=s=>{const p=String(s).split('-');return p.length===3?(+p[2])+' '+AY[(+p[1])-1]:s;};
        const shortMonth=s=>{const p=String(s).split('-');return p.length===2?AY[(+p[1])-1]+' '+p[0].slice(2):s;};
        const movingAvg=(arr,w)=>arr.map((_,i)=>{const s=Math.max(0,i-w+1);const sl=arr.slice(s,i+1);return sl.reduce((a,b)=>a+b,0)/sl.length;});
        const dMA=movingAvg(d.dValues,7);

        const charts={};
        function peakLabelPlugin(datasetIndex, excludeLastPoint){
            return {
                id: 'peakLabel',
                afterDraw(chart){
                    const meta = chart.getDatasetMeta(datasetIndex);
                    const data = chart.data.datasets[datasetIndex].data;
                    if (!data || !data.length || !meta.data.length) return;

                    const searchLen = (excludeLastPoint && data.length > 1) ? data.length - 1 : data.length;
                    let maxI = 0, minI = 0;
                    for (let i = 1; i < searchLen; i++) {
                        if (data[i] > data[maxI]) maxI = i;
                        if (data[i] < data[minI]) minI = i;
                    }

                    const ctx = chart.ctx;
                    const area = chart.chartArea;
                    const blinkOn = Math.floor(Date.now() / 600) % 2 === 0;

                    const drawBadge = (idx, isMax) => {
                        const point = meta.data[idx];
                        if (!point) return;
                        const label = full(data[idx]);
                        const color = isMax ? '#00a97c' : '#dc2626';
                        ctx.save();

                        if (blinkOn) {
                            ctx.beginPath();
                            ctx.arc(point.x, point.y, 3.5, 0, Math.PI*2);
                            ctx.fillStyle = color;
                            ctx.fill();
                            ctx.lineWidth = 1.5;
                            ctx.strokeStyle = '#fff';
                            ctx.stroke();
                        } else {
                            ctx.beginPath();
                            ctx.arc(point.x, point.y, 3.5, 0, Math.PI*2);
                            ctx.lineWidth = 1.5;
                            ctx.strokeStyle = color;
                            ctx.stroke();
                        }

                        ctx.font = '700 11px system-ui,sans-serif';
                        const textW = ctx.measureText(label).width;
                        const padX = 6, boxW = textW + padX*2, boxH = 18, gap = 10;

                        const spaceAbove = point.y - area.top;
                        const spaceBelow = area.bottom - point.y;
                        const needed = boxH + gap + 4;
                        const placeAbove = isMax
                            ? spaceAbove >= needed || spaceAbove >= spaceBelow
                            : !(spaceBelow >= needed || spaceBelow >= spaceAbove);

                        let boxY = placeAbove ? (point.y - gap - boxH) : (point.y + gap);
                        boxY = Math.max(area.top + 2, Math.min(boxY, area.bottom - boxH - 2));
                        const boxX = Math.max(area.left + 2, Math.min(point.x - boxW/2, area.right - boxW - 2));

                        ctx.fillStyle = '#ffffff';
                        ctx.strokeStyle = color;
                        ctx.lineWidth = 1.3;
                        if (ctx.roundRect) { ctx.beginPath(); ctx.roundRect(boxX, boxY, boxW, boxH, 5); ctx.fill(); ctx.stroke(); }
                        else { ctx.fillRect(boxX, boxY, boxW, boxH); ctx.strokeRect(boxX, boxY, boxW, boxH); }

                        ctx.fillStyle = color;
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillText(label, boxX + boxW/2, boxY + boxH/2 + 0.5);
                        ctx.restore();
                    };

                    drawBadge(maxI, true);
                    if (minI !== maxI) drawBadge(minI, false);
                }
            };
        }

        setInterval(() => {
            if (charts.daily) charts.daily.draw();
            if (charts.monthly) charts.monthly.draw();
        }, 300);

        charts.daily=new Chart(dailyChart,{type:'line',data:{labels:d.dLabels.map(shortDay),datasets:[
            {label:'Günlük',data:d.dValues,borderColor:GREEN,backgroundColor:soft(GREEN,.10),fill:true,tension:.35,pointRadius:0,borderWidth:2.5,order:2},
            {label:'7G Ort.',data:dMA,borderColor:MINT,borderDash:[6,4],fill:false,tension:.4,pointRadius:0,borderWidth:2,order:1}
        ]},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:20,bottom:20}},plugins:{legend:{display:true,position:'top',align:'end',labels:{boxWidth:10,font:{size:10},padding:8}},tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+full(c.parsed.y)}}},scales:{...yA(),x:{grid:{display:false},ticks:{maxTicksLimit:8}}}},plugins:[peakLabelPlugin(0)]});

        const CT_COLORS=['#00a97c','#2563eb','#c77d0a','#7c3aed','#db2777'];
        charts.continent=new Chart(continentTrendChart,{type:'line',data:{labels:d.ctLabels.map(shortDay),datasets:d.ctSeries.map((s,i)=>({label:s.Continent,data:movingAvg(s.Values,3),borderColor:CT_COLORS[i%CT_COLORS.length],backgroundColor:'transparent',borderWidth:2,tension:.35,pointRadius:0}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:true,position:'bottom',labels:{boxWidth:7,font:{size:8},padding:5}},tooltip:{callbacks:{label:c=>' '+c.dataset.label+': '+full(c.parsed.y)}}},scales:{y:{ticks:{callback:money,font:{size:8}},grid:{color:GRID},border:{display:false}},x:{grid:{display:false},ticks:{maxTicksLimit:4,font:{size:8}}}}}});

        const lastIdx=d.mValues.length-1;
        charts.monthly=new Chart(monthlyChart,{type:'line',data:{labels:d.mLabels.map(shortMonth),datasets:[{data:d.mValues,borderColor:GREEN,backgroundColor:soft(GREEN,.12),fill:true,tension:.35,borderWidth:2.5,pointRadius:d.mValues.map((_,i)=>i===lastIdx?3:0),pointBackgroundColor:'#fff',pointBorderColor:GREEN,segment:{borderDash:c=>c.p1DataIndex===lastIdx?[6,4]:undefined,borderColor:c=>c.p1DataIndex===lastIdx?soft(GREEN,.5):GREEN}}]},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:20,bottom:20}},plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+full(c.parsed.y)+(c.dataIndex===lastIdx?'  (devam ediyor)':'')}}},scales:{...yA(),x:{grid:{display:false},ticks:{maxTicksLimit:6}}}},plugins:[peakLabelPlugin(0,true)]});


        charts.platformTrend=new Chart(platformTrendChart,{type:'line',data:{labels:d.ptLabels.map(shortMonth),datasets:[
            {data:d.ptYoutube,borderColor:'@merzigoColor(0)',backgroundColor:'transparent',borderWidth:2,tension:.35,pointRadius:0},
            {data:d.ptFacebook,borderColor:'#7FD7BF',backgroundColor:'transparent',borderWidth:2,tension:.35,pointRadius:0}
        ]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+(c.datasetIndex===0?'YouTube':'Facebook')+': '+full(c.parsed.y)}}},scales:{y:{ticks:{callback:money,font:{size:8}},grid:{color:GRID},border:{display:false}},x:{grid:{display:false},ticks:{maxTicksLimit:6,font:{size:8}}}}}});

        const centerText={
id:'centerText',
afterDraw(chart){
const {ctx}=chart;
const meta=chart.getDatasetMeta(0);
if(!meta.data.length)return;

const total=d.psValues.reduce((a,b)=>a+b,0);
const cx=meta.data[0].x;
const cy=meta.data[0].y;

ctx.save();

meta.data.forEach((arc,i)=>{
const angle=(arc.startAngle+arc.endAngle)/2;
const radius=(arc.innerRadius+arc.outerRadius)/2;

const x=cx+Math.cos(angle)*radius;
const y=cy+Math.sin(angle)*radius;

let size=18;
if((arc.outerRadius-arc.innerRadius)<60) size=15;

ctx.textAlign='center';
ctx.textBaseline='middle';
ctx.fillStyle='#fff';
ctx.font=`800 ${size}px system-ui`;
ctx.fillText(d.psPct[i],x,y-size*0.5);

ctx.font=`700 ${size-2}px system-ui`;
ctx.fillText(d.psVal[i],x,y+size*0.65);
});

ctx.textAlign='center';
ctx.textBaseline='middle';
ctx.fillStyle='#6b8079';
ctx.font='600 13px system-ui';
ctx.fillText('Toplam Gelir',cx,cy-12);

ctx.fillStyle='#00a97c';
ctx.font='700 20px system-ui';
ctx.fillText(money(total),cx,cy+12);

ctx.restore();
}
};

charts.platformSlice=new Chart(platformSliceDonut,{
type:'doughnut',
data:{labels:d.psLabels,datasets:[{data:d.psValues,backgroundColor:d.psColors,borderWidth:0,hoverOffset:0}]},
options:{
responsive:true,
maintainAspectRatio:false,
cutout:'48%',
layout:{padding:6},
plugins:{legend:{display:false},tooltip:{enabled:false}}
},
plugins:[centerText]
});

(function(){
            let html=''; const src=d.moverNames.map((l,i)=>({l,v:d.moverPct[i]}));
            for (let i=src.length-1; i>0; i--){ const j=Math.floor(Math.random()*(i+1)); [src[i],src[j]]=[src[j],src[i]]; }
            const pool=src.concat(src);
            pool.forEach(x=>{ const pct=Number(x.v).toFixed(1); const up=x.v>=0;
                html+=`<span class="ticker-item">${x.l} <span class="${up?'u':'dn'}">${up?'▲':'▼'} %${Math.abs(pct)}</span></span>`; });
            const track=document.getElementById('tickerTrack');
            track.innerHTML=html||'<span class="ticker-item">Veri yok</span>';

            const PX_PER_SEC=55;
            const halfWidth=track.scrollWidth/2;
            const duration=Math.max(20, halfWidth/PX_PER_SEC);
            track.style.animationDuration=duration+'s';
        })();

        // Aylık Şirket Liderlik Tablosu — mini sparkline'lar
        (function(){
            document.querySelectorAll('.lead-spark').forEach(svg => {
                const pts = (svg.dataset.points || '').split(',').map(Number).filter(n => !isNaN(n));
                if (pts.length < 2) return;
                const max = Math.max(...pts), min = Math.min(...pts, 0);
                const range = (max - min) || 1;
                const step = 60 / (pts.length - 1);
                const coords = pts.map((v, i) => `${(i * step).toFixed(1)},${(21 - ((v - min) / range) * 19).toFixed(1)}`).join(' ');

                const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
                poly.setAttribute('points', coords);
                poly.setAttribute('fill', 'none');
                poly.setAttribute('stroke', '#00a97c');
                poly.setAttribute('stroke-width', '2');
                poly.setAttribute('stroke-linecap', 'round');
                poly.setAttribute('stroke-linejoin', 'round');
                svg.appendChild(poly);
            });
        })();



        // Ülke Bazlı Coğrafi Gelir Analizi — 3D Interactive Globe (Merzigo tema)
        (function(){
            try{
            const countries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.TopCountries.Select(c => new { c.Country, c.CountryCode, c.Percentage, c.Latitude, c.Longitude, RevenueLabel = compactMoney(c.Revenue),
                    Continent = RevenueDashboard.Infrastructure.ContinentData.CountryToContinent.TryGetValue(c.Country, out var cont) ? cont : "Diğer" })));

            const geoWrap = document.getElementById('globeViz');
            if (!geoWrap || countries.length === 0) return;

            const LAND = '#00a97c';
            const OCEAN = '#eaf6f0';
            const GLOW = '#00a97c';

            const GLOBE_SIZE = Math.min(260, geoWrap.clientWidth || 260, geoWrap.clientHeight || 260);

            const world = Globe()
                (geoWrap)
                .backgroundColor('rgba(0,0,0,0)')
                .showAtmosphere(true)
                .atmosphereColor(GLOW)
                .atmosphereAltitude(0.18)
                .htmlElementsData(countries)
                .htmlLat('Latitude')
                .htmlLng('Longitude')
                .htmlAltitude(0.01)
                .htmlElement(c => {
                    const wrap = document.createElement('div');
                    wrap.className = 'geo-pin-wrap';
                    wrap.dataset.country = c.Country;

                    const dot = document.createElement('div');
                    dot.className = 'geo-dot-pin';

                    const badge = document.createElement('div');
                    badge.className = 'geo-badge';
                    badge.innerHTML = `<span class="fi fi-${c.CountryCode}"></span> ${c.Country}: <b>${c.RevenueLabel}</b> (${c.Continent}'nın %${c.Percentage.toFixed(1)}'si)`;

                    wrap.appendChild(dot);
                    wrap.appendChild(badge);
                    return wrap;
                })
                .width(GLOBE_SIZE)
                .height(GLOBE_SIZE);

            const mat = world.globeMaterial();
            mat.color.set(OCEAN);
            mat.shininess = 2;

            fetch('https://cdn.jsdelivr.net/npm/globe.gl/example/datasets/ne_110m_admin_0_countries.geojson')
                .then(res => res.json())
                .then(geo => {
                    world
                        .polygonsData(geo.features)
                        .polygonCapColor(() => LAND)
                        .polygonSideColor(() => 'rgba(0,77,56,0.25)')
                        .polygonStrokeColor(() => GLOW)
                        .polygonAltitude(0.006);
                })
                .catch(() => { });

            const REST_ALT = 1.25, FOCUS_ALT = 0.95;
            world.pointOfView({ lat: 20, lng: 5, altitude: REST_ALT }, 0);
            requestAnimationFrame(() => world.width(GLOBE_SIZE).height(GLOBE_SIZE));

            world.controls().autoRotate = true;
            world.controls().autoRotateSpeed = 0.7;
            world.controls().enableZoom = false;

            const BASE_SPEED = 0.7;
            const RAMP_MS = 700;
            const FLY_MS = 2200;
            const STAY_MS = 3000;
            const TRAVEL_MS = 3500;

            function decelerateThenFly(c, onArrive){
                const rampStart = performance.now();
                function ramp(){
                    const t = Math.min((performance.now() - rampStart) / RAMP_MS, 1);
                    world.controls().autoRotateSpeed = BASE_SPEED * (1 - t);
                    if (t < 1) {
                        requestAnimationFrame(ramp);
                    } else {
                        world.controls().autoRotate = false;
                        world.controls().autoRotateSpeed = BASE_SPEED;
                        world.pointOfView({ lat: c.Latitude, lng: c.Longitude, altitude: FOCUS_ALT }, FLY_MS);
                        setTimeout(onArrive, FLY_MS);
                    }
                }
                ramp();
            }

            let idx = 0;
            function cycle(){
                const i = idx % countries.length;
                const c = countries[i];

                decelerateThenFly(c, () => {
                    document.querySelectorAll('.geo-pin-wrap').forEach(w => w.classList.remove('show'));
                    const active = document.querySelector(`.geo-pin-wrap[data-country="${CSS.escape(c.Country)}"]`);
                    if (active) active.classList.add('show');
                });

                setTimeout(() => {
                    document.querySelectorAll('.geo-pin-wrap').forEach(w => w.classList.remove('show'));
                    world.controls().autoRotate = true;
                    idx++;
                    setTimeout(cycle, TRAVEL_MS);
                }, RAMP_MS + FLY_MS + STAY_MS);
            }
            setTimeout(cycle, 1800);

          window.addEventListener('resize', () => {
                const s = Math.min(260, geoWrap.clientWidth || 260, geoWrap.clientHeight || 260);
                world.width(s).height(s);
            });
          } catch (err) {
            console.warn('3D küre yüklenemedi (WebGL devre dışı olabilir):', err);
            const geoWrap = document.getElementById('globeViz');
            if (geoWrap) geoWrap.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:.75rem;text-align:center;padding:1rem;">Bu tarayıcıda 3D küre görüntülenemiyor (WebGL devre dışı)</div>';
          }
        })();
        const screens=[document.getElementById('screen1'),document.getElementById('screen2')];
        const chartGroups=[['daily','continent'],['monthly','platformTrend','platformSlice']];
        const titles=[['Kısa Vade','Günlük & operasyonel'],['Uzun Vade','Aylık & yıllık strateji']];
        const dots=[...document.querySelectorAll('.dots span')];
        const titleEl=document.getElementById('screenTitle');
        const ring=document.getElementById('ringFg');
        const C=2*Math.PI*15; ring.style.strokeDasharray=C;
        let cur=0, playing=true, elapsed=0; const PERIOD=30;
        function show(i,dir){
            const prev=cur; cur=(i+screens.length)%screens.length;
            screens.forEach((s,k)=>{ s.classList.remove('in-right','in-left'); s.classList.toggle('active',k===cur); });
            const dd=dir!==undefined?dir:(cur>prev?1:-1);
            screens[cur].classList.add(dd>=0?'in-right':'in-left');
            dots.forEach((dt,k)=>dt.classList.toggle('on',k===cur));
            titleEl.innerHTML=titles[cur][0];
            chartGroups[cur].forEach(n=>{ if(charts[n]) charts[n].update(); });
            elapsed=0;
        }
        function tick(){ if(!playing) return; elapsed++; ring.style.strokeDashoffset=C*(1-elapsed/PERIOD); if(elapsed>=PERIOD) show(cur+1,1); }
        setInterval(tick,1000);
        document.getElementById('nextBtn').onclick=()=>show(cur+1,1);
        document.getElementById('prevBtn').onclick=()=>show(cur-1,-1);
        dots.forEach(dt=>dt.onclick=()=>show(+dt.dataset.i));
        document.getElementById('playBtn').onclick=function(){ playing=!playing; this.textContent=playing?'⏸':'▶'; };
        document.getElementById('fsBtn').onclick=()=>{ if(!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen(); };
        const gunler=['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
        function clock(){ const n=new Date(); const p=x=>String(x).padStart(2,'0');
            document.getElementById('clockTime').textContent=p(n.getHours())+':'+p(n.getMinutes())+':'+p(n.getSeconds());
            document.getElementById('clockDate').textContent=n.getDate()+' '+AY[n.getMonth()]+' '+gunler[n.getDay()]; }
        clock(); setInterval(clock,1000);
    </script>
</body>
</html>
