@model RevenueDashboard.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var daily = Model.DailyRevenue;
    var dailyAvg = daily.Any() ? daily.Average(x => x.Value) : 0;
    var thisMonth = Model.PeriodRevenue.ThisMonth;
    var lastMonth = Model.PeriodRevenue.LastMonth;
    var monthChange = lastMonth > 0 ? (thisMonth - lastMonth) / lastMonth * 100 : 0;
    var today = Model.PeriodRevenue.Today;
    var yesterday = Model.PeriodRevenue.Yesterday;
    var dayChange = yesterday > 0 ? (today - yesterday) / yesterday * 100 : 0;
    var thisYear = Model.PeriodRevenue.ThisYear;
    var lastYear = Model.PeriodRevenue.LastYear;
    var yearChange = lastYear > 0 ? (thisYear - lastYear) / lastYear * 100 : 0;

    var lastDayLabel = daily.Any()
        ? DateTime.Parse(daily.Last().Label).ToString("d MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
        : "-";

    var userName = User.Identity?.Name ?? "Kullanıcı";
    var roleLabel = User.IsInRole("Admin") ? "Administrator" : "Kullanıcı";

    string arrow(decimal v) => v >= 0 ? "↑" : "↓";
    string cls(decimal v) => v >= 0 ? "up" : "down";
   string alarm(decimal v) => v < 0 ? "alarm" : "";
    string fmtDate(string iso) => DateTime.TryParse(iso, out var dt) ? dt.ToString("dd MMM yyyy") : iso;
    const decimal USD_TRY_RATE = 47.35m; // 27 Temmuz 2026 piyasa kuru
    string compactMoney(decimal v)
    {
        var usd = v / USD_TRY_RATE;
        var abs = Math.Abs(usd);
        if (abs >= 1_000_000m)
            return "$" + (usd / 1_000_000m).ToString("N1", System.Globalization.CultureInfo.InvariantCulture) + "M";
        if (abs >= 1_000m)
            return "$" + (usd / 1_000m).ToString("N1", System.Globalization.CultureInfo.InvariantCulture) + "K";
        return "$" + usd.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
    }
    string[] merzigoPalette = { "#00a97c", "#03936C", "#7dd8bb", "#0b6b52", "#5fcf9f", "#004d38" };
    string merzigoColor(int i) => merzigoPalette[i % merzigoPalette.Length];
    string platIcon(string p) => p switch
    {
        "YouTube" => "▶",
        "Facebook" => "f",
        "Dailymotion & TikTok" => "♪",
        "TV & Syndication" => "📺",
        _ => "●"
    };
    string platColor(string p) => p switch
    {
        "YouTube" => "#FF0000",
        "Facebook" => "#1877F2",
        "Dailymotion & TikTok" => "#000000",
        "TV & Syndication" => "#03936C",
        _ => "#00a97c"
    };
    string kpiIconSvg(string key)
    {
        string paths = key switch
        {
            "wallet" => "<path d=\"M21 12V7H5a2 2 0 0 1 0-4h14v4\"/><path d=\"M3 5v14a2 2 0 0 0 2 2h16v-5\"/><path d=\"M18 12a2 2 0 0 0 0 4h4v-4Z\"/>",
            "trending-up" => "<polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"/><polyline points=\"16 7 22 7 22 13\"/>",
            "bar-chart-3" => "<path d=\"M3 3v18h18\"/><path d=\"M18 17V9\"/><path d=\"M13 17V5\"/><path d=\"M8 17v-3\"/>",
            "banknote" => "<rect width=\"20\" height=\"12\" x=\"2\" y=\"6\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M6 12h.01M18 12h.01\"/>",
            "building-2" => "<path d=\"M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z\"/><path d=\"M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2\"/><path d=\"M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2\"/><path d=\"M10 6h4\"/><path d=\"M10 10h4\"/><path d=\"M10 14h4\"/><path d=\"M10 18h4\"/>",
            _ => ""
        };
        return $"<svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{paths}</svg>";
    }


}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Revenue Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.3/css/flag-icons.min.css" />
    <style>
        :root{ --accent:#00a97c; --accent-dark:#03936C; --red:#dc2626; --amber:#c77d0a;
            --accent-soft:#EBF5F0; --card-bg:#f1f8f5; --ink:#1f2d29; --muted:#6b8079; --line:#ade4d0;
            --line-soft:#d9ece4; --bg:#f7faf9; --card:#fff; }
        *{ box-sizing:border-box; }
        html,body{ margin:0; height:100%; }
        body{ background:var(--bg); font-family:system-ui,-apple-system,'Segoe UI',sans-serif;
            color:var(--ink); -webkit-font-smoothing:antialiased; font-size:13px; }

        .topbar{ background:var(--card); border-bottom:1px solid var(--line-soft); padding:0 1.5rem; height:56px;
            display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20; }
        .brand{ display:flex; align-items:center; gap:.55rem; }
        .brand .logo{ width:30px; height:30px; border-radius:8px; background:var(--accent); color:#fff; display:grid; place-items:center; font-weight:800; }
        .brand .bt{ font-weight:700; font-size:.98rem; line-height:1.15; }
        .brand .bs{ font-size:.68rem; color:var(--muted); line-height:1.15; }
        .topright{ display:flex; align-items:center; gap:.9rem; }
        .deck-ctrl{ display:flex; align-items:center; gap:.7rem; }
        .ring{ width:34px; height:34px; transform:rotate(-90deg); }
        .ring circle{ fill:none; stroke-width:3; }
        .ring .bg{ stroke:var(--line-soft); }
        .ring .fg{ stroke:var(--accent); stroke-linecap:round; transition:stroke-dashoffset .3s linear; }
        .ctrl-btn{ width:32px; height:32px; border-radius:8px; border:1px solid var(--line); background:var(--card); display:grid; place-items:center; cursor:pointer; color:var(--accent-dark); font-size:.9rem; transition:all .15s; }
        .ctrl-btn:hover{ background:var(--accent-soft); }
        .screen-title{ font-size:.78rem; font-weight:700; color:var(--ink); min-width:130px; text-align:center; }
        .screen-title small{ display:block; font-size:.64rem; color:var(--muted); font-weight:500; }
        .divider{ width:1px; height:28px; background:var(--line-soft); }
        .clock{ text-align:right; font-size:.72rem; color:var(--muted); line-height:1.3; }
        .clock b{ color:var(--ink); font-weight:700; font-size:.9rem; font-variant-numeric:tabular-nums; }
        .clock .dt{ display:flex; align-items:center; gap:.3rem; justify-content:flex-end; }
        .clock .dot{ width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
        .user-chip{ display:flex; align-items:center; gap:.55rem; padding:.25rem .7rem .25rem .3rem; border:1px solid var(--line-soft); border-radius:22px; }
        .user-chip .av{ width:30px; height:30px; border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:.8rem; font-weight:700; }
        .user-chip .nm{ font-size:.8rem; font-weight:700; line-height:1.2; }
        .user-chip .rl{ font-size:.68rem; color:var(--muted); line-height:1.2; }
        .icon-btn{ width:34px; height:34px; border-radius:8px; border:1px solid var(--line); background:var(--card); display:grid; place-items:center; cursor:pointer; text-decoration:none; color:var(--accent-dark); transition:all .15s; }
        .icon-btn:hover{ background:var(--accent-soft); }

        .wrap{ padding:.9rem 1.5rem .5rem; max-width:1720px; margin:0 auto; }
        .screen{ display:none; }
        .screen.active{ display:block; }
        .screen.in-right{ animation:slideR .5s ease; }
        .screen.in-left{ animation:slideL .5s ease; }
        @@keyframes slideR{ from{opacity:0; transform:translateX(40px);} to{opacity:1; transform:none;} }
        @@keyframes slideL{ from{opacity:0; transform:translateX(-40px);} to{opacity:1; transform:none;} }

        .grid{ display:grid; gap:.8rem; }
        .row-main{ grid-template-columns:1.6fr 1fr; margin-bottom:.8rem; }
        .portfolio-platform-row{ grid-template-columns:1.3fr 1.2fr; }
        .row-main > .card2{ min-width:0; }

        .cpp-list{ display:flex; flex-direction:column; height:100%; }
        .cpp-head{ display:grid; grid-template-columns:20% 12% 18% 32% 18%; gap:0; padding:.3rem .5rem .5rem; border-bottom:1px solid var(--line); flex:0 0 auto; }
        .cpp-head span{ font-size:.64rem; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); font-weight:700; padding-right:1.5rem; }
        .cpp-head span.num{ text-align:right; }
        .cpp-row{ display:grid; grid-template-columns:20% 12% 18% 32% 18%; gap:0; align-items:center; flex:1 1 0; min-height:0; padding:0 .5rem; border-bottom:1px solid var(--line-soft); }
        .cpp-row:last-child{ border-bottom:none; }
        .cpp-row:hover{ background:var(--accent-soft); }
        .cpp-row span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding-right:1.5rem; }
        .cpp-company{ font-weight:700; color:var(--ink); font-size:.86rem; text-align:left; }
        .cpp-channels{ font-weight:700; color:var(--ink); font-size:.86rem; text-align:left; padding-left:0 !important; }
        .cpp-content{ color:var(--ink); font-size:.82rem; font-weight:500; text-align:left; }
        .cpp-num{ text-align:right; font-variant-numeric:tabular-nums; color:var(--accent-dark); font-weight:800; font-size:.84rem; }

        .ph2-body{ display:flex; gap:1rem; height:100%; min-height:0; }
        .ph2-trend{ flex:1 1 66%; display:flex; flex-direction:column; min-width:0; min-height:0; }
        .ph2-trend-legend{ display:flex; gap:.9rem; margin-bottom:.25rem; font-size:.72rem; font-weight:700; color:var(--ink); flex:0 0 auto; }
        .ph2-trend-legend i{ display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:.3rem; vertical-align:middle; }
        .ph2-donut{ flex:1 1 34%; position:relative; min-width:0; min-height:0; }
        .ph2-donut canvas{ width:100% !important; height:100% !important; }

        .card2{ background:var(--card-bg); border:1px solid var(--line); border-radius:12px; padding:.8rem .95rem; }

        .card2 h5{ font-size:.86rem; font-weight:700; margin:0 0 .05rem; color:var(--ink); }
        .card2 .q{ font-size:.76rem; color:#4d635c; margin-bottom:.5rem; }
        .panel-body{ position:relative; flex:1; min-height:0; }
        .flexcard{ display:flex; flex-direction:column; }

        /* Üst KPI Kartları */
        .kpi-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:.8rem; margin-bottom:.8rem; }
        .kpi{ position:relative; overflow:hidden; }
        .kpi.alarm::before{ content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--red); }
        .kpi .top{ display:flex; align-items:center; justify-content:space-between; }
        .kpi .label{ color:var(--ink); font-size:.86rem; font-weight:700; }
        .kpi .ic{ width:32px; height:32px; border-radius:50%; background:var(--accent-soft); color:var(--accent-dark); display:grid; place-items:center; }
        .kpi .value{ font-size:1.4rem; font-weight:800; margin:.3rem 0 .05rem; letter-spacing:-.02em; color:var(--accent); }
        .kpi .value.ink{ color:var(--ink); font-size:1.15rem; }
        .kpi .sub{ font-size:.75rem; color:var(--muted); }
        .kpi .desc{ font-size:.68rem; color:var(--muted); margin-top:.15rem; opacity:.85; }
        .kpi-date-highlight{ font-size:.64rem; font-weight:800; color:var(--muted); margin:0; line-height:1; }
        .value-wrap{ display:flex; flex-direction:column; gap:1px; }
        .chg.up{ color:var(--accent-dark); font-weight:700; } .chg.down{ color:var(--red); font-weight:700; }

        /* Aylık Şirket Liderlik Tablosu — satırlar kart yüksekliğini eşit paylaşır, boşluk kalmaz */
        .lead-list{ display:flex; flex-direction:column; height:100%; }
        .lead-row{ display:grid; grid-template-columns:34px minmax(0,1fr) 96px 64px 76px; align-items:center; gap:.75rem; flex:1 1 0; min-height:0; border-bottom:1px solid var(--line-soft); }
        .lead-row:last-child{ border-bottom:none; }
        .lead-rank{ width:28px; height:28px; border-radius:8px; background:var(--accent-soft); display:grid; place-items:center; font-size:.86rem; font-weight:800; color:var(--accent-dark); }
        .lead-row:first-child .lead-rank{ background:var(--accent); color:#fff; }
        .lead-name{ font-weight:700; color:var(--ink); font-size:.92rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .lead-val{ text-align:right; font-weight:800; color:var(--ink); font-size:.9rem; font-variant-numeric:tabular-nums; white-space:nowrap; }
        .lead-chg{ text-align:right; font-weight:800; font-size:.84rem; white-space:nowrap; }
        .lead-chg.up{ color:var(--accent-dark); }
        .lead-chg.down{ color:var(--red); }
        .lead-spark{ width:68px; height:28px; }

        /* Platform Performansı — karşılaştırmalı (dumbbell) grafik */
        .dumbbell-list{ display:flex; flex-direction:column; gap:.7rem; height:100%; justify-content:center; }
        .dumbbell-row{ display:grid; grid-template-columns:88px 1fr 96px; align-items:center; gap:.6rem; }
        .dumbbell-name{ font-size:.78rem; font-weight:700; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .dumbbell-track{ position:relative; height:20px; }
        .dumbbell-line{ position:absolute; top:50%; height:3px; background:var(--line-soft); border-radius:2px; transform:translateY(-50%); }
        .dumbbell-dot{ position:absolute; top:50%; width:11px; height:11px; border-radius:50%; transform:translate(-50%,-50%); }
        .dumbbell-dot.prev{ background:var(--line); }
        .dumbbell-dot.curr.up{ background:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
        .dumbbell-dot.curr.down{ background:var(--red); box-shadow:0 0 0 3px rgba(220,38,38,.15); }
        .dumbbell-meta{ text-align:right; }
        .dumbbell-val{ font-size:.78rem; font-weight:800; color:var(--ink); font-variant-numeric:tabular-nums; }
        .dumbbell-pct{ font-size:.7rem; font-weight:800; }
        .dumbbell-pct.up{ color:var(--accent-dark); }
        .dumbbell-pct.down{ color:var(--red); }

        /* Gelir Yoğunlaşma Riski */
        .risk-card{ display:flex; flex-direction:column; justify-content:center; height:100%; gap:.5rem; }
        .risk-headline{ display:flex; align-items:baseline; gap:.6rem; }
        .risk-pct{ font-size:2.1rem; font-weight:800; color:var(--ink); letter-spacing:-.02em; }
        .risk-tag{ font-size:.7rem; font-weight:800; padding:.2rem .55rem; border-radius:12px; text-transform:uppercase; letter-spacing:.02em; }
        .risk-tag.risk-low{ background:var(--accent-soft); color:var(--accent-dark); }
        .risk-tag.risk-mid{ background:#fdf1de; color:var(--amber); }
        .risk-tag.risk-high{ background:#fde2e2; color:var(--red); }
        .risk-caption{ font-size:.76rem; color:var(--muted); }
        .risk-bar{ height:10px; border-radius:6px; background:var(--line-soft); overflow:hidden; display:flex; }
        .risk-bar-fill{ height:100%; background:linear-gradient(90deg, var(--accent), #00e0a0); }

        /* Ülke Bazlı Coğrafi Gelir Analizi */
        .geo-body{ display:flex; gap:.7rem; flex:1; min-height:0; min-width:0; align-items:center; }
        .geo-left{ flex:1; display:flex; flex-direction:column; gap:.4rem; justify-content:space-between; overflow:hidden; min-width:0; }
        .geo-row{ display:flex; align-items:center; gap:.5rem; }
        .geo-dot{ width:12px; height:12px; border-radius:50%; flex-shrink:0; }
        .geo-info{ flex:1; min-width:0; }
        .geo-top{ display:flex; justify-content:space-between; align-items:baseline; }
        .geo-name{ font-size:.76rem; font-weight:700; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .geo-pct{ font-size:.72rem; font-weight:800; color:var(--accent-dark); }
        .geo-bar{ height:5px; border-radius:4px; background:var(--line-soft); overflow:hidden; margin:.2rem 0 .1rem; }
        .geo-bar>span{ display:block; height:100%; border-radius:4px; background:linear-gradient(90deg, #7dd8bb, var(--accent)); }
        .geo-row.lead .geo-bar>span{ background:linear-gradient(90deg, var(--accent), #00e0a0); box-shadow:0 0 8px rgba(0,169,124,.5); }
        .geo-row.lead .geo-name{ color:var(--accent-dark); }
        .geo-val{ font-size:.68rem; color:var(--muted); font-variant-numeric:tabular-nums; }

        .geo-right{ flex:0 0 260px; width:260px; height:260px; max-width:260px; max-height:260px;
            position:relative; border-radius:10px; overflow:hidden; margin:0 auto; }
        .geo-right canvas{ border-radius:10px; width:100% !important; height:100% !important; display:block; }

        .geo-pin-wrap{ position:relative; }
        .geo-dot-pin{ position:absolute; top:0; left:0; width:6px; height:6px; margin:-3px 0 0 -3px;
            border-radius:50%; background:#00a97c;
            opacity:0; transform:scale(.3);
            box-shadow:0 0 0 2px rgba(255,255,255,.9), 0 0 6px rgba(0,169,124,.8);
            transition:opacity .35s ease, transform .35s ease; }
        .geo-pin-wrap.show .geo-dot-pin{ opacity:1; transform:scale(1); animation:geoDotGlow 1.6s ease-in-out infinite; }
        @@keyframes geoDotGlow{
            0%, 100% { box-shadow:0 0 0 2px rgba(255,255,255,.9), 0 0 6px rgba(0,169,124,.8); }
            50%      { box-shadow:0 0 0 2px rgba(255,255,255,.9), 0 0 14px rgba(0,169,124,1); }
        }

        .geo-badge{ position:absolute; top:0; left:0; background:rgba(255,255,255,.95); border:1px solid var(--accent);
            border-radius:8px; padding:.3rem .55rem; white-space:normal; max-width:180px; text-align:center; line-height:1.3;
            font-size:.66rem; font-weight:700; color:var(--ink);
            pointer-events:none; box-shadow:0 4px 16px rgba(0,169,124,.35);
            opacity:0; transform:translate(-50%, calc(-100% - 30px)) scale(.85);
            transition:opacity .35s ease, transform .35s ease; }
        .geo-pin-wrap.show .geo-badge{ opacity:1; transform:translate(-50%, calc(-100% - 30px)) scale(1); }
        .geo-badge b{ color:var(--accent-dark); }
        .geo-pin-wrap.show .geo-badge::after{ content:""; position:absolute; left:50%; bottom:-30px; width:1px; height:24px;
            background:rgba(0,169,124,.55); transform:translateX(-50%); }

        .ticker{ background:var(--accent-soft); border-top:1px solid var(--line); border-bottom:1px solid var(--line);
            overflow:hidden; white-space:nowrap; padding:.35rem 0; display:flex; align-items:center; position:sticky; bottom:0; }
        .ticker-track{ display:inline-block; white-space:nowrap; animation:scroll 45s linear infinite; }
        .ticker-item{ display:inline-block; padding:0 1.4rem; font-size:.82rem; font-weight:600; color:var(--ink); }
        .ticker-item .u{ color:var(--accent-dark); font-weight:800; } .ticker-item .dn{ color:var(--red); font-weight:800; }
        @@keyframes scroll{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

        .dots{ display:flex; justify-content:center; gap:.5rem; padding:.4rem 0; }
        .dots span{ width:8px; height:8px; border-radius:50%; background:var(--line); cursor:pointer; transition:all .2s; }
        .dots span.on{ background:var(--accent); width:22px; border-radius:5px; }

        /* Yeni 1. ekran — Kanal, Ülke Trend ve Platform performansı */
        .executive-bottom{ grid-template-columns:0.9fr 1fr 1.1fr; }
        .channel-performance{ display:flex; flex-direction:column; flex:1; min-height:0; }
        .channel-performance-row{ display:grid; grid-template-columns:32px minmax(0,1fr) 108px; align-items:center; gap:.75rem; padding:.5rem .2rem; border-bottom:1px solid var(--line-soft); }
        .channel-performance-row:last-child{ border-bottom:none; }
        .channel-rank{ width:26px; height:26px; display:grid; place-items:center; border-radius:8px; background:var(--accent-soft); color:var(--accent-dark); font-weight:800; font-size:.8rem; }
        .channel-performance-row:first-child .channel-rank{ background:var(--accent); color:white; }
        .channel-info{ min-width:0; }
        .channel-name{ font-size:.9rem; font-weight:700; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .channel-company{ margin-top:2px; font-size:.74rem; font-weight:500; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .channel-figures{ text-align:right; }
        .channel-revenue{ font-size:.9rem; font-weight:800; color:var(--ink); white-space:nowrap; line-height:1.2; }
        .channel-change{ margin-top:2px; font-size:.78rem; font-weight:800; white-space:nowrap; }
        .positive{ color:var(--accent-dark); }
        .negative{ color:var(--red); }
        .platform-executive-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:.65rem; flex:1; }
        .platform-executive-card{ background:white; border:1px solid var(--line-soft); border-radius:10px; padding:.75rem; min-width:0; }
        .platform-exec-header{ display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
        .platform-exec-title{ display:flex; align-items:center; gap:.4rem; font-size:.78rem; font-weight:700; }
        .platform-exec-icon{ width:24px; height:24px; display:grid; place-items:center; border-radius:7px; color:white; font-weight:800; }
        .platform-exec-change{ font-size:.76rem; font-weight:800; }
        .platform-exec-revenue{ margin-top:.55rem; font-size:1.25rem; line-height:1; font-weight:800; color:var(--accent-dark); }
        .platform-exec-caption{ margin-top:.25rem; font-size:.65rem; color:var(--muted); }
        .platform-divider{ height:1px; background:var(--line-soft); margin:.65rem 0; }
        .platform-leader-label{ font-size:.6rem; font-weight:800; letter-spacing:.05em; color:var(--muted); }
        .platform-leader{ margin-top:.25rem; font-size:.73rem; font-weight:700; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .platform-leader-revenue{ margin-top:.15rem; font-size:.7rem; font-weight:800; color:var(--accent-dark); }

        
#screen1 .kpi .body{display:flex;justify-content:space-between;align-items:flex-start;margin-top:4px;}
#screen1 .kpi .changeBox{text-align:right;min-width:70px;}
