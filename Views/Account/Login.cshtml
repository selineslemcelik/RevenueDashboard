@model RevenueDashboard.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap · Revenue Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root{ --accent:#00a97c; --accent-dark:#03936C; --accent-soft:#EBF5F0; --card-bg:#f1f8f5;
            --ink:#0f2e26; --muted:#6b8079; --line:#ade4d0; --red:#dc2626; --card:#fff; --bg:#f7faf9; }
        *{ box-sizing:border-box; }
        html,body{ margin:0; height:100%; }
        body{ font-family:system-ui,-apple-system,'Segoe UI',sans-serif; color:var(--ink);
            background:var(--card-bg);
            min-height:100vh; display:flex; flex-direction:column; -webkit-font-smoothing:antialiased; }

        .shell{ flex:1; display:grid; place-items:center; padding:1.5rem; }
        .auth{ width:100%; max-width:420px; background:var(--card); border:1px solid var(--line); border-radius:16px;
            box-shadow:0 12px 40px rgba(15,46,38,.08); padding:2.6rem 2.4rem;
            animation:fade .5s ease; }
        @@keyframes fade{ from{ opacity:0; transform:translateY(12px);} to{ opacity:1; transform:none;} }

        .brandhead{ text-align:center; margin-bottom:1.8rem; }
        .brandhead .logo{ width:52px; height:52px; border-radius:14px; background:var(--accent); color:#fff;
            display:grid; place-items:center; font-size:1.5rem; font-weight:800; margin:0 auto 1rem; }
        .brandhead h1{ font-size:1.15rem; font-weight:700; margin:0; color:var(--ink); }

        .formside h2{ font-size:1.4rem; font-weight:700; margin:0 0 .3rem; color:var(--ink); text-align:center; }
        .formside .lead{ font-size:.88rem; color:var(--muted); margin:0 0 1.6rem; text-align:center; }
        .field{ margin-bottom:1.05rem; }
        .field label{ display:block; font-size:.8rem; font-weight:600; color:var(--ink); margin-bottom:.4rem; }
        .inp{ position:relative; }
        .inp .pre{ position:absolute; left:.85rem; top:50%; transform:translateY(-50%); font-size:.95rem; opacity:.6; }
        .inp input{ width:100%; padding:.72rem .9rem .72rem 2.5rem; font-size:.9rem; color:var(--ink);
            border:1.5px solid var(--line); border-radius:11px; outline:none; transition:all .16s ease; background:#fff; }
        .inp input::placeholder{ color:#9fb3ab; }
        .inp input:focus{ border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
        .inp .toggle{ position:absolute; right:.7rem; top:50%; transform:translateY(-50%); cursor:pointer;
            font-size:1rem; opacity:.6; background:none; border:none; padding:.2rem; }
        .inp .toggle:hover{ opacity:1; }
        .btn-signin{ width:100%; padding:.8rem; font-size:.95rem; font-weight:700; color:#fff; border:none;
            border-radius:11px; background:var(--accent); cursor:pointer; transition:all .18s ease; margin-top:.3rem;
            display:flex; align-items:center; justify-content:center; gap:.5rem; }
        .btn-signin:hover{ background:var(--accent-dark); transform:translateY(-1px); box-shadow:0 8px 20px rgba(3,147,108,.28); }
        .create{ text-align:center; font-size:.85rem; color:var(--muted); margin-top:1.3rem; }
        .create a{ color:var(--accent-dark); font-weight:700; text-decoration:none; }
        .create a:hover{ text-decoration:underline; }
        .err-box{ background:#fdeaea; border:1px solid #f5c2c2; color:var(--red); border-radius:11px;
            padding:.7rem .9rem; font-size:.83rem; margin-bottom:1.2rem; display:flex; align-items:center; gap:.5rem; }
        .field-err{ color:var(--red); font-size:.76rem; margin-top:.35rem; display:flex; align-items:center; gap:.3rem; }
        .inp.invalid input{ border-color:var(--red); }
        .inp.invalid input:focus{ box-shadow:0 0 0 3px #fdeaea; }
        .pagefoot{ text-align:center; padding:1rem; font-size:.75rem; color:var(--muted); line-height:1.5; }
    </style>
</head>
<body>
    <div class="shell">
        <div class="auth">
            <div class="brandhead">
                <div class="logo">R</div>
                <h1>Revenue Dashboard</h1>
            </div>

            <div class="formside">
                <h2>Tekrar Hoş Geldiniz</h2>
                <p class="lead">Yönetici panosuna erişmek için giriş yapın.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    <div class="err-box"><span>⚠️</span> @ViewData.ModelState[""].Errors.First().ErrorMessage</div>
                }

                <form asp-action="Login" method="post" id="loginForm">
                    <div class="field">
                        <label>Kullanıcı Adı</label>
                        <div class="inp @(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "invalid" : "")">
                            <span class="pre">👤</span>
                            <input asp-for="Username" placeholder="kullanıcı adınız" autocomplete="username" autofocus />
                        </div>
                        @if (ViewData.ModelState["Username"]?.Errors.Count > 0)
                        {
                            <div class="field-err"><span>⚠</span> @ViewData.ModelState["Username"].Errors.First().ErrorMessage</div>
                        }
                    </div>

                    <div class="field">
                        <label>Şifre</label>
                        <div class="inp @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "invalid" : "")">
                            <span class="pre">🔒</span>
                            <input asp-for="Password" type="password" id="pw" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="toggle" id="pwToggle" tabindex="-1">👁</button>
                        </div>
                        @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                        {
                            <div class="field-err"><span>⚠</span> @ViewData.ModelState["Password"].Errors.First().ErrorMessage</div>
                        }
                    </div>

                    <button type="submit" class="btn-signin">Giriş Yap →</button>

                    <div class="create">Hesabınız yok mu? <a asp-action="Register">Hesap Oluştur</a></div>
                </form>
            </div>
        </div>
    </div>
    <div class="pagefoot">© 2026 Revenue Dashboard · Version 1.0</div>

    <script>
        const pw = document.getElementById('pw');
        document.getElementById('pwToggle').addEventListener('click', () => {
            pw.type = pw.type === 'password' ? 'text' : 'password';
        });
    </script>
</body>
</html>
